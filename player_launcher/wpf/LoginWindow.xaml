<adu:AduWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:adu="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin" xmlns:local="clr-namespace:DNFLogin" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DNFLogin.LoginWindow" x:Name="RootWindow" Title="DNF Login" Icon="{images:ClientImage login-icon.ico}" Width="1280" Height="728" ResizeMode="NoResize" WindowStyle="None" SysButtonVisible="Collapsed" Background="Transparent" AllowsTransparency="True" BorderThickness="0" Opacity="0" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" xmlns:images="clr-namespace:DNFLogin.Services">
    <adu:AduWindow.Resources>
        <Style x:Key="TopNavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="30,10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Underline" Height="3" Fill="#FFE84A3A" RadiusX="1.5" RadiusY="1.5" Margin="22,0" VerticalAlignment="Bottom" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                                <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="50" Height="50" Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="2">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE84A3A" />
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>
        <Style x:Key="NoticeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8CCD5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFD6CF" />
                                <Setter TargetName="TabSurface" Property="Background" Value="#3CE84A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NoticeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F1F3F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </adu:AduWindow.Resources>
    <Grid Background="Transparent">
        <Grid x:Name="RootContainer" Grid.RowSpan="2" ClipToBounds="True" Background="#171920" MouseLeftButtonDown="RootContainer_MouseLeftButtonDown">
            <Image x:Name="BackgroundLayer1" Stretch="Fill" IsHitTestVisible="False" />
            <Image x:Name="BackgroundLayer2" Stretch="Fill" IsHitTestVisible="False" Opacity="0" />
        </Grid>
        <Border x:Name="GlassOverlay" Grid.RowSpan="2" Margin="0,68,0,0" Background="#C8101014" Panel.ZIndex="2" Visibility="Collapsed" />
        <Image Source="{images:ClientImage logo.png}" Height="56" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="112,20,0,0" Panel.ZIndex="1" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="10">
            <Button x:Name="MinimizeButton" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="MinIcon" Text="—" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MinIcon" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseButton" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="CloseIcon" Text="×" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseIcon" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <Border Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Background="#CC141419" CornerRadius="22" Padding="10,7" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavGame" Content="开始游戏" GroupName="TopNav" Style="{StaticResource TopNavRadioStyle}" Checked="Nav_Checked" />
                <RadioButton x:Name="NavCdk" Content="CDK兑换" GroupName="TopNav" Style="{StaticResource TopNavRadioStyle}" Margin="6,0,0,0" Checked="Nav_Checked" />
                <RadioButton x:Name="NavSettings" Content="设置" GroupName="TopNav" Style="{StaticResource TopNavRadioStyle}" Margin="6,0,0,0" Checked="Nav_Checked" />
            </StackPanel>
        </Border>
        <Grid Grid.RowSpan="2" Panel.ZIndex="3">
            <Grid x:Name="PageLogin">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Rectangle RadiusX="16" RadiusY="16" Width="348" Margin="0,-115,40,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=RootContainer}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="18" />
                        </Rectangle.Effect>
                    </Rectangle>
                    <Border Width="440" Height="198" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,48"
                            Background="#EE191D27" BorderBrush="#46536377" BorderThickness="1" CornerRadius="12" Padding="13,11">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="#42546377" Padding="0,0,0,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button x:Name="AllNoticesButton" DockPanel.Dock="Right" Content="全部 ↗" FontSize="12"
                                            Style="{StaticResource NoticeButtonStyle}" AutomationProperties.Name="查看全部公告"
                                            Click="AllNotices_Click" IsEnabled="False" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="综合" GroupName="NoticeCategory" IsChecked="True" Style="{StaticResource NoticeTabStyle}" Click="NoticeTab_Click" />
                                        <RadioButton x:Name="NoticeUpdates" Content="更新" GroupName="NoticeCategory" Style="{StaticResource NoticeTabStyle}" Click="NoticeTab_Click" />
                                        <RadioButton x:Name="NoticeGuides" Content="指南" GroupName="NoticeCategory" Style="{StaticResource NoticeTabStyle}" Click="NoticeTab_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ServerNoticeList" />
                                </ScrollViewer>
                                <TextBlock x:Name="ServerNoticeStatus" Text="正在获取公告…" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#BAC4D4" FontSize="13" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="LoginPanelsContainer" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-115,40,0">
                        <Border Background="#B0101015" Padding="26" CornerRadius="16" Width="348">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="登录游戏" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LoginVersionText" Text="S5A11" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                                </StackPanel>
                                <StackPanel x:Name="LoginFormPanel">
                                    <TextBlock Text="账号" Foreground="#CCFFFFFF" Margin="0,8,0,4" />
                                    <TextBox x:Name="AccountTextBox" Height="32" FontSize="13" Padding="10,4" VerticalContentAlignment="Center" Background="#1FFFFFFF" Foreground="White" BorderBrush="#33FFFFFF" BorderThickness="1" KeyDown="LoginInput_KeyDown" />
                                    <StackPanel>
                                        <TextBlock Text="密码" Foreground="#CCFFFFFF" Margin="0,8,0,4" />
                                        <PasswordBox x:Name="PasswordBox" Height="32" FontSize="13" Padding="10,4" VerticalContentAlignment="Center" Background="#1FFFFFFF" Foreground="White" BorderBrush="#33FFFFFF" BorderThickness="1" KeyDown="LoginInput_KeyDown" />
                                    </StackPanel>
                                    <TextBlock x:Name="MainLoggedInText" Foreground="#FF2ECC71" FontSize="12" Margin="2,8,0,0" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <CheckBox x:Name="RememberCheckBox" Content="记住密码" Foreground="#CCFFFFFF" />
                                        <Button x:Name="ClearButton" Content="清除" Foreground="#FFE84A3A" FontSize="12" Background="Transparent" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" ToolTip="清除账号密码及已保存的凭据" Click="ClearButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <Button x:Name="LoginButton" Content="登 录" Height="36" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Margin="0,12,0,6" Cursor="Hand" IsDefault="True" Click="LoginButton_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FFE84A3A" Offset="0" />
                                                <GradientStop Color="#FFC62828" Offset="1" />
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Color="#FFC62828" />
                                        </Button.Effect>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="0">
                                                    <Grid>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border x:Name="HoverOverlay" CornerRadius="10" Background="#45FFFFFF" Opacity="0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FF9E9E9E" />
                                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="RegisterButton" Content="注 册" Height="36" Background="#F2F3F5" Foreground="#333333" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="RegisterButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E1E3E6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel HorizontalAlignment="Right" Margin="0,2,2,0">
                                        <Button x:Name="ForgotPasswordButton" Content="忘记密码？" Foreground="#8FC7FF" FontSize="12" Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand" ToolTip="使用救援代码找回密码" Click="ForgotPasswordButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter TargetName="Bd" Property="Background" Value="#1A8FC7FF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="ConnectionStatusPanel" Margin="2,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="服务器状态：" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center" />
                                            <Image x:Name="OnlineStatusImage" Width="16" Height="16" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="OnlineStatusText" Text="检测中…" Foreground="#CCFFFFFF" FontSize="13" Margin="4,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="登录模式：" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ModeStatusText" Text="本地模式" Foreground="#CCFFFFFF" FontSize="13" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
            <local:SettingsControl x:Name="SettingsPage" Margin="0,68,0,0" Visibility="Collapsed" />
            <Grid x:Name="CdkHost" Margin="0,68,0,0" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="BgProgressWrap" Grid.RowSpan="2" Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Panel.ZIndex="5">
            <Rectangle x:Name="BgProgressBar" Fill="#FF36373A" HorizontalAlignment="Left" Width="0" />
        </Grid>
        <StackPanel x:Name="ToastContainer" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,16,0" Width="320" Panel.ZIndex="20" />
    </Grid>
</adu:AduWindow>
