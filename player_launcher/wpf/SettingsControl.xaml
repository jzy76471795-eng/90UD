<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DNFLogin.SettingsControl" xmlns:images="clr-namespace:DNFLogin.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,0,0,0">
            <RadioButton x:Name="NavBase" Content="基础设置" GroupName="SettingsSubNav" Style="{StaticResource SubNavRadioStyle}" IsChecked="True" />
            <RadioButton x:Name="NavAbout" Content="关于" GroupName="SettingsSubNav" Style="{StaticResource SubNavRadioStyle}" Margin="24,0,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid x:Name="PageSettings" Margin="40,28,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="基础设置" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <Border Grid.Row="1" Background="#222329" CornerRadius="16" Margin="0,20,0,0">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="退出游戏时弹出" Foreground="#E6FFFFFF" FontSize="13" VerticalAlignment="Center" />
                        <ToggleButton x:Name="ToggleExitPopup" Grid.Column="1" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource SwitchStyle}" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#222329" CornerRadius="16" Margin="0,20,0,0">
                    <Grid Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="关闭窗口" Foreground="#E6FFFFFF" FontSize="13" />
                        <RadioButton x:Name="RadioTray" Grid.Row="1" Content="最小化到系统托盘" GroupName="CloseBehavior" Style="{StaticResource RadioStyle}" Checked="CloseBehavior_Checked" Margin="0,12,0,0" />
                        <RadioButton x:Name="RadioExit" Grid.Row="2" Content="退出启动器" GroupName="CloseBehavior" Style="{StaticResource RadioStyle}" Checked="CloseBehavior_Checked" Margin="0,10,0,0" />
                    </Grid>
                </Border>
                <Button x:Name="ClearAllConfigButton" Grid.Row="4" Content="清除所有配置" Height="36" FontSize="13" Foreground="White" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,0,0" Click="ClearAllConfigButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBd" Background="#6E1A16" BorderBrush="#FFE84A3A" BorderThickness="1" CornerRadius="8" Padding="20,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBd" Property="Background" Value="#8A241D" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Grid x:Name="PageAbout" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="AboutVersionText" Text="YH登录器" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="本工具仅做学习与研究使用，不得用于包括但不限于非法盈利及任何非法用途。" Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="本工具所使用的素材、标志等著作权均归各著作权人（单位）所有。" Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="本工具请下载后于24小时内删除，如因违反相关法律法规出现任何后果自行承担，工具开发者不承担任何责任。使用本工具则默认您同意本规则，如不同意请立即删除本工具。" Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AboutDcLinkText" Foreground="#99FFFFFF" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Run Text="DC群：" Foreground="#99FFFFFF" />
                        <Hyperlink NavigateUri="https://discord.gg/kxppgMyT7" RequestNavigate="AboutDcLink_RequestNavigate" Foreground="#4FA8FF" Cursor="Hand">
                            <Run Text="https://discord.gg/kxppgMyT7" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
