    <SkipType name="*AnonymousType*" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />
    <SkipType name="DNFLogin.Services.PythonSavedLogin" skipMethods="true" skipFields="true" skipProperties="true" skipEvents="true" />
